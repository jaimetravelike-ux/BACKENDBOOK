# Copia este archivo a ".env" para desarrollo local (nunca subas el .env real
# a git - ya esta en .gitignore). En Railway, estas mismas variables se
# configuran directamente en el panel del proyecto (Variables), no con este
# archivo.

# Puerto local (Railway asigna el suyo automaticamente vía PORT)
PORT=8787

# Claude (chatbot) - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# RapidAPI (Booking.com provider) - https://rapidapi.com
RAPIDAPI_KEY=

# Postgres (conversaciones, leads, contactos, cache de precios por proveedor)
DATABASE_URL=

# Clave simple para proteger los paneles /admin/* (?key=...)
ADMIN_KEY=

# SMTP para el aviso por email de consultas de contacto (opcional: si falta
# cualquiera de estas, el email simplemente se omite sin romper nada)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_NOTIFY_TO=

# Pago (Redsys) - ver src/payment.js
# USE_PAYMENT_MOCK=true (o sin definir) usa el simulador local, sin llamar a
# Redsys ni necesitar credenciales - deja esto asi mientras el banco aprueba
# los terminos legales. El dia que lleguen las credenciales reales, pon
# USE_PAYMENT_MOCK=false y rellena las 3 variables de Redsys de abajo: no
# hace falta tocar ningun codigo, el interruptor esta en payment.js.
USE_PAYMENT_MOCK=true
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=
REDSYS_SECRET_KEY=
REDSYS_ENV=test
REDSYS_MERCHANT_URL=
REDSYS_URL_OK=
REDSYS_URL_KO=
